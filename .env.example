# WaveSpeed — satu key untuk semua model AI (DEC-24 / BR-014)
# Jangan commit nilai sungguhan. Lihat rules/security.md
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://api.wavespeed.ai
WAVESPEED_REQUEST_TIMEOUT_MS=30000

# Opsional: level log CLI
# VIDEO_STUDIO_LOG_LEVEL=info

# Remotion Lambda (opsional) — nama variabel mengikuti docs Remotion Lambda saat setup
# AWS credentials tidak disimpan di repo

# Google Drive handoff (OQ-33 / TASK-USR-006) — OAuth Desktop app
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Token refresh disimpan di luar repo setelah `drive-auth`
