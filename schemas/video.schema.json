{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bintangku.app/schemas/video.schema.json",
  "title": "BintangkuVideo",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "language",
    "targetDuration",
    "beats",
    "status",
    "history"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^\\d{8}-[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "pillar": { "type": "string" },
    "language": { "type": "string", "default": "id" },
    "targetDuration": { "type": "integer", "enum": [30, 60] },
    "voiceOverride": { "type": "object" },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "shots"],
        "properties": {
          "id": { "type": "string", "pattern": "^b\\d{2}$" },
          "text": { "type": "string", "minLength": 1 },
          "speech": { "type": "string" },
          "delivery": {
            "type": "string",
            "enum": ["spoken", "sung"],
            "default": "spoken"
          },
          "minSlots": { "type": "integer", "minimum": 1 },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "object" }
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "vo_ready",
        "preview_ready",
        "in_review",
        "moderation_flagged",
        "changes_requested",
        "approved",
        "rendering",
        "rendered",
        "archived"
      ]
    },
    "reviewNotes": { "type": "array" },
    "approval": { "type": ["object", "null"] },
    "history": { "type": "array" }
  }
}
