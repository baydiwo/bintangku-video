{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bintangku.app/schemas/voice.schema.json",
  "title": "VoiceConfig",
  "type": "object",
  "required": ["provider", "model", "locked"],
  "properties": {
    "provider": { "const": "wavespeed" },
    "model": { "type": "string", "minLength": 1 },
    "voice_id": { "type": ["string", "null"] },
    "settings": { "type": "object" },
    "returns_alignment": { "type": "boolean" },
    "locked": { "type": "boolean" }
  }
}
